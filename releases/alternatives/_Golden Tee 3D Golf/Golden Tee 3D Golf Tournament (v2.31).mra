<?xml version='1.0' encoding='utf-8'?>
<misterromdescription>
    <name>Golden Tee 3D Golf Tournament (v2.31)</name>
    <setname>gt3dt231</setname>
    <rbf>ITech32</rbf>
    <mameversion>0288</mameversion>
    <year>1995</year>
    <manufacturer>Incredible Technologies</manufacturer>
    <players>4</players>
    <joystick>Trackball</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Incredible Technologies 32-bit</platform>
    <category>Sports</category>
    <!--DIP bits0..3 map to native masks10/20/40/80, physical SW1:4/3/2/1.-->
    <switches default="00">
        <dip name="Trackball Mount" bits="1" ids="Normal,45 Degrees" />
        <dip name="Controls" bits="2" ids="One Trackball,Two Trackballs" />
        <dip name="Service Mode" bits="3" ids="Off,On" />
    </switches>
    <!--MAME: B1 Face Left, B2 Face Right; player 1's B3/B4 are the cabinet's Volume Up/Down. The mouse, left stick or d-pad moves trackball 1; with Two Trackballs set, player 2 uses the second controller's stick or d-pad.-->
    <buttons names="Face Left,Face Right,Volume Up,Volume Down,-,-,Start,Coin" default="A,B,X,Y,Start,Select" count="4" />
    <!--Board selector 11 must precede the address30000000 bulk stream.-->
    <rom index="1">
        <part>11</part>
    </rom>
    <!-- 128 KiB battery-backed NVRAM at CPU 0x600000-0x61ffff, then the 2 KiB M48T02 timekeeper at 0x681000-0x6817ff. -->
    <nvram index="2" size="133120" />
    <rom index="0" zip="gt3dt231.zip|gt3d.zip" address="0x30000000" md5="ea6504dfc3615e253de4a85108b6edc1">
        <!-- 0x0000000: 68EC020 program, 4 MiB. -->
        <interleave output="32">
            <part name="gtg3_prom0_v2.31t.prom0" crc="92a5c3e9" map="0001" />
            <part name="gtg3_prom1_v2.31t.prom1" crc="a3b60226" map="0010" />
            <part name="gtg3_prom2_v2.31t.prom2" crc="d1659616" map="0100" />
            <part name="gtg3_prom3_v2.31t.prom3" crc="1d231ea2" map="1000" />
        </interleave>
        <!-- 0x0400000: 6809 sound region; bank 0 at 0x10000. -->
        <part repeat="0x8000">00</part>
        <part name="gtg3nr_u88_v1.0.u88" crc="2cee9e98" offset="0x18000" length="0x8000" />
        <part name="gtg3nr_u88_v1.0.u88" crc="2cee9e98" offset="0x0" length="0x18000" />
        <part repeat="0xd8000">00</part>
        <!-- 0x0500000: GROM; the blitter wraps at the 0x600000 MAME region. -->
        <interleave output="32">
            <part name="gtg3_grom0_0.grm0_0" crc="1b10379d" map="0001" />
            <part name="gtg3_grom0_1.grm0_1" crc="3b852e1a" map="0010" />
            <part name="gtg3_grom0_2.grm0_2" crc="d43ffb35" map="0100" />
            <part name="gtg3_grom0_3.grm0_3" crc="2d24e93e" map="1000" />
        </interleave>
        <interleave output="32">
            <part name="gtg3_grom1_0.grm1_0" crc="4476b239" map="0001" />
            <part name="gtg3_grom1_1.grm1_1" crc="0aadfad2" map="0010" />
            <part name="gtg3_grom1_2.grm1_2" crc="27871980" map="0100" />
            <part name="gtg3_grom1_3.grm1_3" crc="7dbc242b" map="1000" />
        </interleave>
        <interleave output="32">
            <part name="gtg3_grom2_0_t.grm2_0" crc="80ae7148" map="0001" />
            <part name="gtg3_grom2_1_t.grm2_1" crc="0f85a618" map="0010" />
            <part name="gtg3_grom2_2_t.grm2_2" crc="09ca5fbf" map="0100" />
            <part name="gtg3_grom2_3_t.grm2_3" crc="d136853a" map="1000" />
        </interleave>
        <part repeat="0x1b00000">00</part>
        <!-- 0x2600000: ES5506 bank 0 (ensoniq.0), slot A. -->
        <interleave output="16">
            <part name="gtg3_srom0_nr.srom0" crc="44983bd7" map="01" />
            <part map="10" repeat="0x100000">00</part>
        </interleave>
        <interleave output="16">
            <part name="gtg3_srom1_nr.srom1" crc="1b3f18b6" map="01" />
            <part map="10" repeat="0x80000">00</part>
        </interleave>
        <part repeat="0x100000">00</part>
        <!-- 0x2a00000: slot B, unused. -->
        <part repeat="0x400000">00</part>
    </rom>
</misterromdescription>
