<?xml version='1.0' encoding='utf-8'?>
<misterromdescription>
    <name>Must Shoot TV (prototype)</name>
    <setname>shoottv</setname>
    <rbf>ITech32</rbf>
    <mameversion>0288</mameversion>
    <year>199?</year>
    <manufacturer>Incredible Technologies</manufacturer>
    <players>2</players>
    <joystick>Light Gun</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Incredible Technologies 32-bit</platform>
    <category>Shooter</category>
    <!--DIP bits0..3 map to native masks10/20/40/80, physical SW1:4/3/2/1.-->
    <switches default="00">
        <dip name="Flip Screen" bits="1" ids="Off,On" />
        <dip name="Service Mode" bits="3" ids="Off,On" />
    </switches>
    <!--MAME: B1 is the gun trigger. Gun 1 aims with the mouse (left button fires), left stick, d-pad or arrow keys (Left Ctrl fires); gun 2 with the second controller. OSD: Light Gun Stick Absolute for MiSTer light guns; Crosshair.-->
    <buttons names="Trigger,-,-,-,-,-,Start,Coin" default="A,Start,Select" count="1" />
    <!--Board selector 13 must precede the address30000000 bulk stream.-->
    <rom index="1">
        <part>13</part>
    </rom>
    <!-- 128 KiB battery-backed NVRAM at CPU 0x600000-0x61ffff. -->
    <nvram index="2" size="131072" />
    <rom index="0" zip="shoottv.zip" address="0x30000000" md5="669d0f3b369096c9d9baaca9e79f1fd7">
        <!-- 0x0000000: 68EC020 program, 0x317e4 bytes of the 4 MiB region (MAME fills 0xff). -->
        <interleave output="32">
            <part name="gun_0.bin" crc="1086b219" map="0001" />
            <part name="gun_1.bin" crc="a0f0e5ea" map="0010" />
            <part name="gun_2.bin" crc="1b84cf05" map="0100" />
            <part name="gun_3.bin" crc="43ed58aa" map="1000" />
        </interleave>
        <part repeat="0x3ce81c">ff</part>
        <!-- 0x0400000: 6809 sound region; bank 0 at 0x10000. -->
        <part repeat="0x8000">00</part>
        <part name="gun.bim" crc="7439569a" offset="0x18000" length="0x8000" />
        <part name="gun.bim" crc="7439569a" offset="0x0" length="0x18000" />
        <part repeat="0xd8000">00</part>
        <!-- 0x0500000: GROM; the blitter wraps at the 0x880000 MAME region. -->
        <interleave output="32">
            <part name="grom00_0.bin" crc="9a06d497" map="0001" />
            <part name="grom00_1.bin" crc="018ff629" map="0010" />
            <part name="grom00_2.bin" crc="f47ea010" map="0100" />
            <part name="grom00_3.bin" crc="3c12be47" map="1000" />
        </interleave>
        <interleave output="32">
            <part name="grom01_0.bin" crc="ebf70a20" map="0001" />
            <part name="grom01_1.bin" crc="a78fedd1" map="0010" />
            <part name="grom01_2.bin" crc="3578d74d" map="0100" />
            <part name="grom01_3.bin" crc="394be494" map="1000" />
        </interleave>
        <part repeat="0x1dc08ac">00</part>
        <!-- 0x2600000: ES5506 bank 0 (ensoniq.0), slot A. The sample ROMs are odd sizes; each fills the even bytes from its MAME offset. -->
        <interleave output="16">
            <part name="guns0.bin" crc="35e9ba70" map="01" />
            <part map="10" repeat="0x7fb51">00</part>
        </interleave>
        <part repeat="0x10095e">00</part>
        <interleave output="16">
            <part name="guns1.bin" crc="ec1c3ab3" map="01" />
            <part map="10" repeat="0x3dccd">00</part>
        </interleave>
        <part repeat="0x184666">00</part>
        <!-- 0x2a00000: slot B, unused. -->
        <part repeat="0x400000">00</part>
    </rom>
</misterromdescription>
