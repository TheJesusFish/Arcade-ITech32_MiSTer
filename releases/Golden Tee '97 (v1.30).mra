<?xml version='1.0' encoding='utf-8'?>
<misterromdescription>
    <name>Golden Tee '97 (v1.30)</name>
    <setname>gt97</setname>
    <rbf>ITech32</rbf>
    <mameversion>0288</mameversion>
    <year>1997</year>
    <manufacturer>Incredible Technologies</manufacturer>
    <players>4</players>
    <joystick>Trackball</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Incredible Technologies 32-bit</platform>
    <category>Sports</category>
    <!--DIP bits0..3 map to native masks10/20/40/80, physical SW1:4/3/2/1.-->
    <switches default="00">
        <dip name="Freeze Screen" bits="0" ids="Off,On" />
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail" />
        <dip name="Service Mode" bits="3" ids="Off,On" />
    </switches>
    <!--MAME: B1 Face Left, B2 Face Right; player 1's B3/B4 are the cabinet's Volume Up/Down. The mouse, left stick or d-pad moves trackball 1; with Two Trackballs set, player 2 uses the second controller's stick or d-pad.-->
    <buttons names="Face Left,Face Right,Volume Up,Volume Down,-,-,Start,Coin" default="A,B,X,Y,Start,Select" count="4" />
    <!--Board selector 0a must precede the address30000000 bulk stream.-->
    <rom index="1">
        <part>0a</part>
    </rom>
    <!-- 128 KiB battery-backed NVRAM at CPU 0x600000-0x61ffff. -->
    <nvram index="2" size="131072" />
    <rom index="0" zip="gt97.zip" address="0x30000000" md5="23ef1ae17a0f71e1cfcf08a4e4a2cba3">
        <!-- 0x0000000: 68EC020 program, 2 MiB of the 4 MiB region. -->
        <interleave output="32">
            <part name="gt97_prom0_v1.30.prom0" crc="7490ba4e" map="0001" />
            <part name="gt97_prom1_v1.30.prom1" crc="71f9c5f3" map="0010" />
            <part name="gt97_prom2_v1.30.prom2" crc="8292b51a" map="0100" />
            <part name="gt97_prom3_v1.30.prom3" crc="64539f72" map="1000" />
        </interleave>
        <part repeat="0x200000">00</part>
        <!-- 0x0400000: 6809 sound region; bank 0 at 0x10000. -->
        <part repeat="0x8000">00</part>
        <part name="gt97nr_u88_v1.0.u88" crc="2cee9e98" offset="0x18000" length="0x8000" />
        <part name="gt97nr_u88_v1.0.u88" crc="2cee9e98" offset="0x0" length="0x18000" />
        <part repeat="0xd8000">00</part>
        <!-- 0x0500000: GROM; the blitter wraps at the 0x600000 MAME region. -->
        <interleave output="32">
            <part name="gt97_grom0_0.grm0_0" crc="81784aaf" map="0001" />
            <part name="gt97_grom0_1.grm0_1" crc="345bda44" map="0010" />
            <part name="gt97_grom0_2.grm0_2" crc="b2beb40d" map="0100" />
            <part name="gt97_grom0_3.grm0_3" crc="7cef32ff" map="1000" />
        </interleave>
        <interleave output="32">
            <part name="gt97_grom1_0.grm1_0" crc="1cc4c309" map="0001" />
            <part name="gt97_grom1_1.grm1_1" crc="512cea45" map="0010" />
            <part name="gt97_grom1_2.grm1_2" crc="0599b505" map="0100" />
            <part name="gt97_grom1_3.grm1_3" crc="257eacc9" map="1000" />
        </interleave>
        <interleave output="32">
            <part name="gt97_grom2_0.grm2_0" crc="95b6e7ee" map="0001" />
            <part name="gt97_grom2_1.grm2_1" crc="afd558b4" map="0010" />
            <part name="gt97_grom2_2.grm2_2" crc="5b7a8733" map="0100" />
            <part name="gt97_grom2_3.grm2_3" crc="72e8ae60" map="1000" />
        </interleave>
        <part repeat="0x1b00000">00</part>
        <!-- 0x2600000: ES5506 bank 0 (ensoniq.0), slot A. -->
        <interleave output="16">
            <part name="gt97_srom0_nr.srom0" crc="44983bd7" map="01" />
            <part map="10" repeat="0x100000">00</part>
        </interleave>
        <interleave output="16">
            <part name="gt97_srom1_nr.srom1" crc="1b3f18b6" map="01" />
            <part map="10" repeat="0x80000">00</part>
        </interleave>
        <part repeat="0x100000">00</part>
        <!-- 0x2a00000: slot B, unused. -->
        <part repeat="0x400000">00</part>
    </rom>
</misterromdescription>
